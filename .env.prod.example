# Copy to .env and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d --build

POSTGRES_USER=academy_prod
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
POSTGRES_DB=physical_eval_portal

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# pydantic-settings parses list-typed env vars as JSON -- use this exact
# bracket/quote format (add more origins as additional quoted strings).
CORS_ORIGINS=["https://your-domain.example"]

# Your real domain -- Caddy issues/renews a Let's Encrypt cert for this
# automatically. DNS A record must point at this VM before first boot.
DOMAIN=your-domain.example
